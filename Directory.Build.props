  Personal project by Thomas Schueler.
  Developed on personal time using personal equipment.
  Not related to any employment.
-->
<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <Authors>Thomas Schueler</Authors>
    <Company>Thomas Schueler</Company>
    <Product>PowerShell GUI Command Builder</Product>
    <Copyright>Copyright (c) 2026 Thomas Schueler. Personal project, developed on personal time using personal equipment. Not related to any employment.</Copyright>
    <!-- The WPF markup compiler builds a *wpftmp project, so exclude that name too. -->
    <TreatWarningsAsErrors Condition="'$(MSBuildProjectName)' != 'PsGuiBuilder' and !$(MSBuildProjectName.Contains('wpftmp'))">true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
