<Window x:Class="PsGuiBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PsGuiBuilder.Controls"
        xmlns:vm="clr-namespace:PsGuiBuilder.ViewModels"
        Title="Shellmason"
        Icon="Assets/PsGuiBuilder.ico"
        Width="1120"
        Height="780"
        MinWidth="880"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <!--
    Personal project by Thomas Schueler.
    Developed on personal time using personal equipment.
    Not related to any employment.
  -->
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:TextSegmentViewModel}">
      <TextBlock Text="{Binding Text}"
                 FontSize="16"
                 VerticalAlignment="Center"
                 Margin="0,0,0,22"
                 TextWrapping="Wrap" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:StringFieldViewModel}">
      <StackPanel Margin="0,0,8,4" MinWidth="150">
        <Border CornerRadius="4" Background="White" BorderThickness="1" MinWidth="150">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="BorderBrush" Value="#E2D8C8" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                  <Setter Property="BorderBrush" Value="#9C4221" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="8,6"
                     FontSize="14" />
            <TextBlock Text="{Binding Placeholder}"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#A8A29E"
                       IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowPlaceholder}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
        <TextBlock Text="{Binding MetaText}" FontSize="11" Foreground="#6F655C" Margin="2,3,0,0" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChoiceFieldViewModel}">
      <StackPanel Margin="0,0,8,4" MinWidth="150">
        <ComboBox ItemsSource="{Binding Choices}"
                  controls:ChoiceBox.SelectedValue="{Binding Value}"
                  MinWidth="150"
                  Padding="6,4"
                  FontSize="14" />
        <TextBlock Text="{Binding MetaText}" FontSize="11" Foreground="#6F655C" Margin="2,3,0,0" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SwitchFieldViewModel}">
      <StackPanel Margin="0,0,8,4" MinWidth="150">
        <CheckBox Content="{Binding Parameter.Label}"
                  IsChecked="{Binding IsChecked}"
                  Margin="0,8,0,0" />
        <TextBlock Text="{Binding MetaText}" FontSize="11" Foreground="#6F655C" Margin="2,3,0,0" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BoolFieldViewModel}">
      <StackPanel Margin="0,0,8,4" MinWidth="150">
        <ComboBox ItemsSource="{Binding Options}"
                  DisplayMemberPath="Label"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding Value}"
                  MinWidth="150"
                  Padding="6,4"
                  FontSize="14" />
        <TextBlock Text="{Binding MetaText}" FontSize="11" Foreground="#6F655C" Margin="2,3,0,0" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SecureFieldViewModel}">
      <StackPanel Margin="0,0,8,4" MinWidth="180">
        <PasswordBox controls:SecretBox.Text="{Binding Secret, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="180"
                     Padding="8,6"
                     FontSize="14" />
        <TextBlock Text="{Binding MetaText}" FontSize="11" Foreground="#6F655C" Margin="2,3,0,0" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ArrayFieldViewModel}">
      <StackPanel Margin="0,0,8,4" MinWidth="220">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,0,0,4" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Remove"
                        Margin="6,0,0,0"
                        Padding="8,4"
                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Add value"
                HorizontalAlignment="Left"
                Padding="8,4"
                Command="{Binding AddRowCommand}" />
        <TextBlock Text="{Binding MetaText}" FontSize="11" Foreground="#6F655C" Margin="2,3,0,0" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="180" />
      <RowDefinition Height="3*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock DockPanel.Dock="Right"
                 Text="Personal project · Thomas Schueler"
                 VerticalAlignment="Bottom"
                 Foreground="#6F655C"
                 FontSize="12" />
      <StackPanel>
        <TextBlock Text="Shellmason" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Personal side project by Thomas Schueler. Built on personal time with personal equipment. No employer resources."
                   Foreground="#6F655C"
                   Margin="0,2,0,0"
                   TextWrapping="Wrap" />
        <TextBlock Text="Favorites are the curated list. Installed commands are discovered from the PowerShell you pick."
                   Foreground="#6F655C"
                   Margin="0,2,0,0"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Background="#1C1917" CornerRadius="8" Padding="0" Margin="0,0,0,14">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="14,10,14,0">
          <TextBlock Text="{Binding StatusText}"
                     DockPanel.Dock="Right"
                     Foreground="#A8A29E"
                     VerticalAlignment="Center" />
          <TextBlock Text="Output" Foreground="#F5F5F4" FontWeight="SemiBold" />
        </DockPanel>
        <RichTextBox x:Name="OutputBox"
                     IsReadOnly="True"
                     IsUndoEnabled="False"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#F5F5F4"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="13"
                     Padding="14,8,14,12"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled">
          <RichTextBox.Resources>
            <Style TargetType="Paragraph">
              <Setter Property="Margin" Value="0" />
            </Style>
          </RichTextBox.Resources>
          <FlowDocument PagePadding="0" />
        </RichTextBox>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16,14">
          <StackPanel IsEnabled="{Binding IsIdle}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <RadioButton Content="Favorites / Common"
                           GroupName="CommandSource"
                           IsChecked="{Binding ShowFavorites}"
                           Margin="0,0,16,0" />
              <RadioButton Content="Installed commands"
                           GroupName="CommandSource"
                           IsChecked="{Binding ShowBrowser}" />
            </StackPanel>
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowBrowser}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Levels}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <controls:SearchableComboBox Label="{Binding Prompt}"
                                                 ItemsSource="{Binding FilteredOptions}"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 SelectedItem="{Binding Selected, Mode=TwoWay}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <DockPanel Margin="0,12,0,0">
              <Button DockPanel.Dock="Right"
                      Content="Look up"
                      Command="{Binding LookupCommand}"
                      Style="{StaticResource SecondaryButton}"
                      Margin="8,0,0,0" />
              <TextBox Text="{Binding CmdletQuery, UpdateSourceTrigger=PropertyChanged}"
                       Padding="10,8"
                       ToolTip="Cmdlet name, such as Get-ChildItem or ActiveDirectory\Get-ADUser" />
            </DockPanel>
            <TextBlock Text="Or look up any installed cmdlet. The form comes from its metadata, not from the tree."
                       Foreground="#6F655C"
                       FontSize="12"
                       Margin="2,6,0,0"
                       TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Margin="0,4,0,0">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowBrowser}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <StackPanel DataContext="{Binding Browser}">
                <DockPanel Margin="0,0,0,8">
                  <Button DockPanel.Dock="Right"
                          Content="Refresh"
                          Command="{Binding RefreshCommand}"
                          Style="{StaticResource SecondaryButton}"
                          Margin="8,0,0,0" />
                  <ComboBox ItemsSource="{Binding Shells}"
                            DisplayMemberPath="Label"
                            SelectedItem="{Binding SelectedShell}"
                            MinWidth="220" />
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                  <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Width="70" />
                  <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </DockPanel>
                <WrapPanel Margin="0,0,0,8">
                  <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="Module" FontSize="11" Foreground="#6F655C" />
                    <ComboBox ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" MinWidth="180" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="Noun" FontSize="11" Foreground="#6F655C" />
                    <ComboBox ItemsSource="{Binding Nouns}" SelectedItem="{Binding SelectedNoun}" MinWidth="140" />
                  </StackPanel>
                  <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="Verb" FontSize="11" Foreground="#6F655C" />
                    <ComboBox ItemsSource="{Binding Verbs}" SelectedItem="{Binding SelectedVerb}" MinWidth="120" />
                  </StackPanel>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <RadioButton Content="Group by module" IsChecked="{Binding GroupByModule}" Margin="0,0,16,0" />
                  <RadioButton Content="Group by noun" IsChecked="{Binding GroupByNoun}" Margin="0,0,16,0" />
                  <CheckBox Content="Include aliases" IsChecked="{Binding IncludeAliases}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow}"
                         MaxHeight="220"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Group}" FontSize="11" Foreground="#6F655C" />
                        <TextBlock>
                          <Run Text="{Binding Title}" FontWeight="SemiBold" />
                          <Run Text="  " />
                          <Run Text="{Binding Detail}" Foreground="#6F655C" />
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Margin="0,8,0,0">
                  <Button DockPanel.Dock="Right"
                          Content="Use this command"
                          Command="{Binding UseCommand}"
                          Style="{StaticResource SecondaryButton}" />
                  <TextBlock Text="{Binding StatusText}"
                             TextWrapping="Wrap"
                             Foreground="#6F655C"
                             VerticalAlignment="Center" />
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Parameters" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="Choose a command to fill in its parameters."
                       Foreground="#6F655C"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasCommand}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding CommandSummary}"
                       Foreground="#6F655C"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding IsIdle}">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasParameterSets}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="Parameter set" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox ItemsSource="{Binding ParameterSetNames}"
                        SelectedItem="{Binding SelectedParameterSet}"
                        MinWidth="220" />
            </StackPanel>
            <DockPanel Margin="0,0,0,8" IsEnabled="{Binding IsIdle}">
              <DockPanel.Style>
                <Style TargetType="DockPanel">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasCommand}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DockPanel.Style>
              <TextBlock DockPanel.Dock="Left" Text="Pipeline" VerticalAlignment="Center" Width="90" />
              <TextBox Text="{Binding PipelineText, UpdateSourceTrigger=PropertyChanged}"
                       Padding="8,6"
                       ToolTip="Optional. Appended after the command, for example Select-Object Name | Out-GridView" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Segments}" IsEnabled="{Binding IsIdle}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="{Binding ValidationText}" Foreground="#9F1239" TextWrapping="Wrap" Margin="0,8,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="PowerShell" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="13"
                     MinHeight="36" />
          </StackPanel>
        </Border>

        <WrapPanel Margin="0,4,0,8">
          <Button Content="{Binding RunButtonText}"
                  Command="{Binding RunCommand}"
                  Style="{StaticResource PrimaryButton}"
                  IsDefault="True"
                  Margin="0,0,8,8" />
          <Button Content="Cancel"
                  Command="{Binding CancelCommand}"
                  Style="{StaticResource SecondaryButton}"
                  IsCancel="True"
                  Margin="0,0,8,8" />
          <Button Content="Start over"
                  Command="{Binding StartOverCommand}"
                  Style="{StaticResource SecondaryButton}"
                  Margin="0,0,8,8" />
          <Button Content="Load new default commands"
                  Click="LoadNewDefaultCommands"
                  Style="{StaticResource SecondaryButton}"
                  IsEnabled="{Binding IsIdle}"
                  Margin="0,0,16,8"
                  ToolTip="Adds commands from the installed default tree that are missing in %APPDATA%\Shellmason\command-tree.json. Entries you already edited stay as they are." />
          <CheckBox Content="Run as administrator"
                    IsChecked="{Binding RunElevated}"
                    IsEnabled="{Binding IsIdle}"
                    VerticalAlignment="Center"
                    Margin="0,0,16,8" />
          <CheckBox Content="Run inside this app"
                    IsChecked="{Binding InProcess}"
                    IsEnabled="{Binding CanRunInProcess}"
                    VerticalAlignment="Center"
                    Margin="0,0,0,8"
                    ToolTip="Uses the embedded PowerShell 7 engine instead of pwsh. It cannot elevate, and it cannot run a command that asks for Windows PowerShell 5.1." />
        </WrapPanel>
        <TextBlock Text="{Binding ElevationHint}" Foreground="#6F655C" TextWrapping="Wrap" Margin="0,0,0,8" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
